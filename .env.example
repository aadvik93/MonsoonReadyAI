# .env.example
# Environment configuration for MonsoonReady AI
# Set LOCAL_DEMO=true for local demo mode (no AWS calls)
LOCAL_DEMO=true
# SQLite database URL (relative to project root)
DATABASE_URL=sqlite:///./app.db
# AWS S3 configuration (only needed if LOCAL_DEMO=false)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
